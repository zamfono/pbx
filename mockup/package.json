{
  "name": "zamfono-mockup",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "description": "Clickable mockup of the Zamfono tenant UI, served at https://demo.zamfono.com (docs/superpowers/specs/2026-10-08-ui-mockup-design.md).",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "deploy": "npm run build && ./scripts/deploy.sh",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "test": "vitest run",
    "prepare": "svelte-kit sync",
    "snapshot:api": "./scripts/extract-openapi.sh"
  },
  "devDependencies": {
    "@fontsource/bricolage-grotesque": "^5.3.0",
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@lucide/lab": "^0.7.0",
    "@lucide/svelte": "^1.53.0",
    "@sveltejs/adapter-static": "^4.0.0",
    "@sveltejs/kit": "^3.0.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^26.6.4",
    "marked": "^18.1.0",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.6",
    "typescript": "^6.0.3",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  },
  "imports": {
    "#lib/*": "./src/lib/*"
  }
}
