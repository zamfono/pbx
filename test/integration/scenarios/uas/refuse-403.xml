<?xml version="1.0" encoding="ISO-8859-1"?>
<!--
  §9.4 "Route fallthrough": the trunk side refusing the call before any alerting with 403, a
  provider rejecting the credentials or the presented number. The call is not this provider's to
  carry, so the core tries the next matching route; nothing here ever answers.
-->
<scenario name="refuse-403">
  <recv request="INVITE" />

  <send>
    <![CDATA[
      SIP/2.0 403 Forbidden
      [last_Via:]
      [last_From:]
      [last_To:];tag=[call_number]
      [last_Call-ID:]
      [last_CSeq:]
      Content-Length: 0
    ]]>
  </send>

  <recv request="ACK" />
</scenario>
