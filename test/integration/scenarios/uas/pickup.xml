<?xml version="1.0" encoding="ISO-8859-1"?>
<!--
  §8 "pickup", the phone side: 101's device rings and does not answer, and a colleague's device
  in the same container dials `*8101` (§9.3 "Feature codes") while it rings. The stack answers
  the colleague into the ringing call and stops the original ring with a CANCEL (§10.1
  "Transfers and pickup"), which this side answers with 200 and a 487 for the INVITE.

  The colleague's call is a sipp run of its own (`pickup-dial.sh`, `pickup-dial.xml`), started
  here once the ring is under way, so each dialog is played by its own scenario: the answer to
  the pickup and this CANCEL leave Asterisk moments apart, in either order. The colleague's SIP
  username and password arrive as `-key user` and `-key pass`.
-->
<scenario name="pickup">
  <recv request="INVITE" rrs="true">
    <action>
      <ereg regexp="[0-9]+" search_in="hdr" header="CSeq:" assign_to="invite_cseq" />
    </action>
  </recv>

  <send>
    <![CDATA[
      SIP/2.0 180 Ringing
      [last_Via:]
      [last_From:]
      [last_To:];tag=[call_number]
      [last_Call-ID:]
      [last_CSeq:]
      Contact: <sip:[local_ip]:[local_port];transport=[transport]>
      Content-Length: 0
    ]]>
  </send>

  <pause milliseconds="500" />

  <!-- The colleague's pickup, from their own device; sipp does not wait for the command. -->
  <nop>
    <action>
      <exec command="sh /scenarios/uas/pickup-dial.sh [user] [pass]" />
    </action>
  </nop>

  <!-- The ring on 101's device stops. -->
  <recv request="CANCEL" timeout="15000" />

  <send>
    <![CDATA[
      SIP/2.0 200 OK
      [last_Via:]
      [last_From:]
      [last_To:]
      [last_Call-ID:]
      [last_CSeq:]
      Content-Length: 0
    ]]>
  </send>

  <send>
    <![CDATA[
      SIP/2.0 487 Request Terminated
      [last_Via:]
      [last_From:]
      [last_To:];tag=[call_number]
      [last_Call-ID:]
      CSeq: [$invite_cseq] INVITE
      Content-Length: 0
    ]]>
  </send>

  <recv request="ACK" />
</scenario>
