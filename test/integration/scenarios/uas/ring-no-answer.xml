<?xml version="1.0" encoding="ISO-8859-1"?>
<!--
  §8: the phone side of the unanswered path. It rings and never answers, so the ring group runs
  out its timeout and the call falls through to the group's own outcome.
-->
<scenario name="ring-no-answer">
  <!-- Asterisk's qualify probe opens a call of its own on this run: answered and ended here, it
       leaves no call behind waiting for an INVITE, so the run ends once its real calls have
       (`_sipp-finish.sh`). -->
  <recv request="OPTIONS" optional="true" next="probe" />

  <recv request="INVITE" rrs="true" />

  <send retrans="500">
    <![CDATA[
      SIP/2.0 180 Ringing
      [last_Via:]
      [last_From:]
      [last_To:];tag=[call_number]
      [last_Call-ID:]
      [last_CSeq:]
      Contact: <sip:[local_ip]:[local_port];transport=[transport]>
      Content-Length: 0
    ]]>
  </send>

  <recv request="CANCEL" timeout="60000" />

  <send>
    <![CDATA[
      SIP/2.0 200 OK
      [last_Via:]
      [last_From:]
      [last_To:]
      [last_Call-ID:]
      [last_CSeq:]
      Content-Length: 0
    ]]>
  </send>

  <send>
    <![CDATA[
      SIP/2.0 487 Request Terminated
      [last_Via:]
      [last_From:]
      [last_To:];tag=[call_number]
      [last_Call-ID:]
      CSeq: [cseq] INVITE
      Content-Length: 0
    ]]>
  </send>

  <!-- The ACK every 487 is owed, awaited: sipp cannot end a call's branch on an optional
       message, and a run still waiting for it holds the transaction open. -->
  <recv request="ACK" />

  <nop next="done" />

  <label id="probe" />
  <send>
    <![CDATA[
      SIP/2.0 200 OK
      [last_Via:]
      [last_From:]
      [last_To:];tag=[call_number]
      [last_Call-ID:]
      [last_CSeq:]
      Content-Length: 0
    ]]>
  </send>

  <label id="done" />
</scenario>
