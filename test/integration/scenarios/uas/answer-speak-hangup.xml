<?xml version="1.0" encoding="ISO-8859-1"?>
<!--
  §8: a phone answering and hanging up itself: it rings briefly, answers, speaks sipp's own A-law
  voice sample (about 6.5 s, so the leg carries RTP both ways and its `call_qos` row measures
  something), and after a few seconds ends the call with a BYE of its own, as a user putting the
  receiver down does. For a call nobody else on it ends: a click-to-dial the user's own phone
  answered, or the picker's phone in an API pickup (§10.2 "Click-to-dial", §10.1 "Pickup").

  The BYE is a request this side originates inside a dialog it answered, so its From is the
  INVITE's To with the tag this side gave it, its To the INVITE's From, and its Request-URI the
  Contact Asterisk sent (as `blind-transfer.xml`'s REFER).
-->
<scenario name="answer speak hangup">
  <!-- Asterisk's qualify probe opens a call of its own on this run: answered and ended here, it
       leaves no call behind waiting for an INVITE, so the run ends once its real calls have
       (`_sipp-finish.sh`). -->
  <recv request="OPTIONS" optional="true" next="probe" />

  <recv request="INVITE" rrs="true">
    <action>
      <ereg regexp=".*" search_in="hdr" header="From:" assign_to="remote_party" />
      <ereg regexp=".*" search_in="hdr" header="To:" assign_to="local_party" />
    </action>
  </recv>

  <send>
    <![CDATA[
      SIP/2.0 180 Ringing
      [last_Via:]
      [last_From:]
      [last_To:];tag=[call_number]
      [last_Call-ID:]
      [last_CSeq:]
      Contact: <sip:[local_ip]:[local_port];transport=[transport]>
      Content-Length: 0
    ]]>
  </send>

  <send retrans="500">
    <![CDATA[
      SIP/2.0 200 OK
      [last_Via:]
      [last_From:]
      [last_To:];tag=[call_number]
      [last_Call-ID:]
      [last_CSeq:]
      Contact: <sip:[local_ip]:[local_port];transport=[transport]>
      Content-Type: application/sdp
      Content-Length: [len]

      v=0
      o=phone 53655765 2353687637 IN IP[local_ip_type] [local_ip]
      s=-
      c=IN IP[media_ip_type] [media_ip]
      t=0 0
      m=audio [media_port] RTP/AVP 8
      a=rtpmap:8 PCMA/8000
    ]]>
  </send>

  <recv request="ACK" rtd="true" crlf="true" />

  <nop>
    <action>
      <exec play_pcap_audio="/sipp/g711a.pcap" />
    </action>
  </nop>
  <pause milliseconds="4000" />

  <send retrans="500">
    <![CDATA[
      BYE [next_url] SIP/2.0
      Via: SIP/2.0/[transport] [local_ip]:[local_port];branch=[branch]
      From: [$local_party];tag=[call_number]
      To: [$remote_party]
      Call-ID: [call_id]
      CSeq: 1 BYE
      Max-Forwards: 70
      Content-Length: 0
    ]]>
  </send>

  <recv response="200" crlf="true" />

  <nop next="done" />

  <label id="probe" />
  <send>
    <![CDATA[
      SIP/2.0 200 OK
      [last_Via:]
      [last_From:]
      [last_To:];tag=[call_number]
      [last_Call-ID:]
      [last_CSeq:]
      Content-Length: 0
    ]]>
  </send>

  <label id="done" />
</scenario>
