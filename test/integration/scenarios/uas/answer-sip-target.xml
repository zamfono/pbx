<?xml version="1.0" encoding="ISO-8859-1"?>
<!--
  §9.4 "SIP targets": the trunk side of a `sip` forward target, behind the `sip-tls` TLS front
  (`inbound-forward-sip.setup.sh` starts both), whose address `[front]` is, so its Contact takes
  Asterisk's in-dialog requests back over TLS. The stack dials the target's user part at this host,
  so the INVITE arrives here; it rings briefly, answers, and waits for the caller to hang up. The
  check reads what arrived from the run's message trace.
-->
<scenario name="answer-sip-target">
  <!-- Asterisk's qualify probe opens a call of its own on this run: answered and ended here, it
       leaves no call behind waiting for an INVITE, so the run ends once its real calls have
       (`_sipp-finish.sh`). -->
  <recv request="OPTIONS" optional="true" next="probe" />

  <recv request="INVITE" rrs="true" />

  <send>
    <![CDATA[
      SIP/2.0 180 Ringing
      [last_Via:]
      [last_From:]
      [last_To:];tag=[call_number]
      [last_Call-ID:]
      [last_CSeq:]
      Contact: <sip:[front]:5061;transport=tls>
      Content-Length: 0
    ]]>
  </send>

  <send retrans="500">
    <![CDATA[
      SIP/2.0 200 OK
      [last_Via:]
      [last_From:]
      [last_To:];tag=[call_number]
      [last_Call-ID:]
      [last_CSeq:]
      Contact: <sip:[front]:5061;transport=tls>
      Content-Type: application/sdp
      Content-Length: [len]

      v=0
      o=phone 53655765 2353687637 IN IP[local_ip_type] [local_ip]
      s=-
      c=IN IP[media_ip_type] [media_ip]
      t=0 0
      m=audio [media_port] RTP/AVP 8
      a=rtpmap:8 PCMA/8000
    ]]>
  </send>

  <recv request="ACK" rtd="true" crlf="true" />

  <recv request="BYE" timeout="30000" />

  <send>
    <![CDATA[
      SIP/2.0 200 OK
      [last_Via:]
      [last_From:]
      [last_To:]
      [last_Call-ID:]
      [last_CSeq:]
      Content-Length: 0
    ]]>
  </send>

  <nop next="done" />

  <label id="probe" />
  <send>
    <![CDATA[
      SIP/2.0 200 OK
      [last_Via:]
      [last_From:]
      [last_To:];tag=[call_number]
      [last_Call-ID:]
      [last_CSeq:]
      Content-Length: 0
    ]]>
  </send>

  <label id="done" />
</scenario>
