<?xml version="1.0" encoding="ISO-8859-1"?>
<!--
  §8: the phone side answering and speaking, as `answer` does but sending sipp's own A-law voice
  sample once the call is up, so a recording of the answering user's participation holds their
  own voice as well as what they heard (§10.2 "Channels and stereo mapping"). Waits for the caller
  to hang up.
-->
<scenario name="answer speak">
  <!-- Asterisk's qualify probe opens a call of its own on this run: answered and ended here, it
       leaves no call behind waiting for an INVITE, so the run ends once its real calls have
       (`_sipp-finish.sh`). -->
  <recv request="OPTIONS" optional="true" next="probe" />

  <recv request="INVITE" rrs="true" />

  <send>
    <![CDATA[
      SIP/2.0 180 Ringing
      [last_Via:]
      [last_From:]
      [last_To:];tag=[call_number]
      [last_Call-ID:]
      [last_CSeq:]
      Contact: <sip:[local_ip]:[local_port];transport=[transport]>
      Content-Length: 0
    ]]>
  </send>

  <send retrans="500">
    <![CDATA[
      SIP/2.0 200 OK
      [last_Via:]
      [last_From:]
      [last_To:];tag=[call_number]
      [last_Call-ID:]
      [last_CSeq:]
      Contact: <sip:[local_ip]:[local_port];transport=[transport]>
      Content-Type: application/sdp
      Content-Length: [len]

      v=0
      o=phone 53655765 2353687637 IN IP[local_ip_type] [local_ip]
      s=-
      c=IN IP[media_ip_type] [media_ip]
      t=0 0
      m=audio [media_port] RTP/AVP 8
      a=rtpmap:8 PCMA/8000
    ]]>
  </send>

  <recv request="ACK" rtd="true" crlf="true" />

  <nop>
    <action>
      <exec play_pcap_audio="/sipp/g711a.pcap" />
    </action>
  </nop>

  <recv request="BYE" timeout="30000" />

  <send>
    <![CDATA[
      SIP/2.0 200 OK
      [last_Via:]
      [last_From:]
      [last_To:]
      [last_Call-ID:]
      [last_CSeq:]
      Content-Length: 0
    ]]>
  </send>

  <nop next="done" />

  <label id="probe" />
  <send>
    <![CDATA[
      SIP/2.0 200 OK
      [last_Via:]
      [last_From:]
      [last_To:];tag=[call_number]
      [last_Call-ID:]
      [last_CSeq:]
      Content-Length: 0
    ]]>
  </send>

  <label id="done" />
</scenario>
