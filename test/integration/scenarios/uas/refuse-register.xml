<?xml version="1.0" encoding="ISO-8859-1"?>
<!--
  §9.4 "Auth mode": the second provider's registrar refusing the trunk's first two REGISTERs with
  403, as a provider does while an account is locked or not yet provisioned, before the real
  registrar (`registrar.xml`) takes the port over. Asterisk retries a registration under the same
  Call-ID, so both REGISTERs are one sipp call: run with `-m 1`.
-->
<scenario name="refuse-register">
  <recv request="REGISTER" />

  <send>
    <![CDATA[
      SIP/2.0 403 Forbidden
      [last_Via:]
      [last_From:]
      [last_To:];tag=[call_number]
      [last_Call-ID:]
      [last_CSeq:]
      Content-Length: 0
    ]]>
  </send>

  <recv request="REGISTER" />

  <send>
    <![CDATA[
      SIP/2.0 403 Forbidden
      [last_Via:]
      [last_From:]
      [last_To:];tag=[call_number]
      [last_Call-ID:]
      [last_CSeq:]
      Content-Length: 0
    ]]>
  </send>
</scenario>
