<?xml version="1.0" encoding="ISO-8859-1"?>
<!--
  test/load/stress: the provider side answering the devices' OUTBOUND calls (the stack routes
  them out through the AMR-WB trunk to this sipp UAS, in the sipp-provider container). Answers
  every INVITE with AMR-WB only, in the payload format of Asterisk's own offer (payload type 98, no
  fmtp, i.e. bandwidth-efficient: an answer with another type or octet-align=1 leaves Asterisk
  unable to decode what this side sends, so the device hears nothing), and replays the ~CALL_S
  AMR-WB pcap make_amrwb_pcap.py packs in exactly that format (amrwb-be98.pcap) once
  (asynchronously).
  Then waits for the device side's BYE; stress-uas-bye.xml is the variant where this side
  hangs up instead (and captures From/To for its own BYE: sipp refuses a scenario that assigns a
  variable it never uses, so this one does not).
-->
<scenario name="stress uas">
  <recv request="INVITE" rrs="true" />

  <send>
    <![CDATA[
      SIP/2.0 180 Ringing
      [last_Via:]
      [last_From:]
      [last_To:];tag=[call_number]
      [last_Call-ID:]
      [last_CSeq:]
      Contact: <sip:[local_ip]:[local_port];transport=[transport]>
      Content-Length: 0
    ]]>
  </send>

  <send retrans="500">
    <![CDATA[
      SIP/2.0 200 OK
      [last_Via:]
      [last_From:]
      [last_To:];tag=[call_number]
      [last_Call-ID:]
      [last_CSeq:]
      Contact: <sip:[local_ip]:[local_port];transport=[transport]>
      Content-Type: application/sdp
      Content-Length: [len]

      v=0
      o=provider 53655765 2353687637 IN IP[local_ip_type] [local_ip]
      s=-
      c=IN IP[media_ip_type] [media_ip]
      t=0 0
      m=audio [media_port] RTP/AVP 98
      a=rtpmap:98 AMR-WB/16000
      a=ptime:20
    ]]>
  </send>

  <recv request="ACK" rtd="true" crlf="true" />

  <nop>
    <action>
      <exec play_pcap_audio="/load-gen/amrwb-be98.pcap"/>
    </action>
  </nop>

  <!-- The device side hangs up (devices_ctrl.py hangup, timed to the call length); no <pause>
       in between, since a BYE arriving during one would be an unexpected message to sipp. -->
  <recv request="BYE" timeout="600000" />

  <send>
    <![CDATA[
      SIP/2.0 200 OK
      [last_Via:]
      [last_From:]
      [last_To:]
      [last_Call-ID:]
      [last_CSeq:]
      Content-Length: 0
    ]]>
  </send>
</scenario>
