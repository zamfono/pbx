<?xml version="1.0" encoding="ISO-8859-1"?>
<!--
  test/load/stress: the provider side answering the devices' OUTBOUND calls (the stack routes
  them out through the AMR-WB trunk to this sipp UAS, in the sipp-provider container). Answers
  every INVITE with AMR-WB only, in the payload format of Asterisk's own offer (payload type 98, no
  fmtp, i.e. bandwidth-efficient: an answer with another type or octet-align=1 leaves Asterisk
  unable to decode what this side sends, so the device hears nothing), and replays the ~CALL_S
  AMR-WB pcap make_amrwb_pcap.py packs in exactly that format (amrwb-be98.pcap) once
  (asynchronously).
  play_pcap_audio is asynchronous in sipp 3.5.1, so the <pause/> (length from sipp's -d) holds
  the call for real time; then this side (the called party, external) sends the BYE.
-->
<scenario name="stress uas">
  <recv request="INVITE" rrs="true">
    <action>
      <ereg regexp=".*" search_in="hdr" header="From:" assign_to="remote_party" />
      <ereg regexp=".*" search_in="hdr" header="To:" assign_to="local_party" />
    </action>
  </recv>

  <send>
    <![CDATA[
      SIP/2.0 180 Ringing
      [last_Via:]
      [last_From:]
      [last_To:];tag=[call_number]
      [last_Call-ID:]
      [last_CSeq:]
      Contact: <sip:[local_ip]:[local_port];transport=[transport]>
      Content-Length: 0
    ]]>
  </send>

  <send retrans="500">
    <![CDATA[
      SIP/2.0 200 OK
      [last_Via:]
      [last_From:]
      [last_To:];tag=[call_number]
      [last_Call-ID:]
      [last_CSeq:]
      Contact: <sip:[local_ip]:[local_port];transport=[transport]>
      Content-Type: application/sdp
      Content-Length: [len]

      v=0
      o=provider 53655765 2353687637 IN IP[local_ip_type] [local_ip]
      s=-
      c=IN IP[media_ip_type] [media_ip]
      t=0 0
      m=audio [media_port] RTP/AVP 98
      a=rtpmap:98 AMR-WB/16000
      a=ptime:20
    ]]>
  </send>

  <recv request="ACK" rtd="true" crlf="true" />

  <nop>
    <action>
      <exec play_pcap_audio="/load-gen/amrwb-be98.pcap"/>
    </action>
  </nop>
  <pause/>

  <send retrans="500">
    <![CDATA[
      BYE [next_url] SIP/2.0
      Via: SIP/2.0/[transport] [local_ip]:[local_port];branch=[branch]
      From: [$local_party];tag=[call_number]
      To: [$remote_party]
      Call-ID: [call_id]
      CSeq: 2 BYE
      Max-Forwards: 70
      Content-Length: 0
    ]]>
  </send>

  <recv response="200" crlf="true" />
</scenario>
