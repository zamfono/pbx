<?xml version="1.0" encoding="ISO-8859-1"?>
<!--
  test/load: the trunk-side answering leg for the forwarded call (played in the sipp-provider
  container, one process per load step serving every concurrent forwarded INVITE Asterisk sends
  it). Modelled on test/integration/scenarios/uas/answer-outbound.xml, but plays real RTP audio
  back (5 plays of sipp's own g711a.pcap, alaw, matching the caller leg, no
  transcoding, ~35s) instead of silence, and never sends its own BYE: the
  caller leg (load-caller.xml) ends the call after its own hold, and this side just waits for it.
  The two provider scenarios differ only in that codec: the pcap a play sends is read when sipp
  loads the scenario, so no `-key` can choose it.
-->
<scenario name="load provider">
  <recv request="INVITE" rrs="true" />

  <send>
    <![CDATA[
      SIP/2.0 180 Ringing
      [last_Via:]
      [last_From:]
      [last_To:];tag=[call_number]
      [last_Call-ID:]
      [last_CSeq:]
      Contact: <sip:[local_ip]:[local_port];transport=[transport]>
      Content-Length: 0
    ]]>
  </send>

  <send retrans="500">
    <![CDATA[
      SIP/2.0 200 OK
      [last_Via:]
      [last_From:]
      [last_To:];tag=[call_number]
      [last_Call-ID:]
      [last_CSeq:]
      Contact: <sip:[local_ip]:[local_port];transport=[transport]>
      Content-Type: application/sdp
      Content-Length: [len]

      v=0
      o=phone 53655765 2353687637 IN IP[local_ip_type] [local_ip]
      s=-
      c=IN IP[media_ip_type] [media_ip]
      t=0 0
      m=audio [media_port] RTP/AVP 8
      a=rtpmap:8 PCMA/8000
    ]]>
  </send>

  <recv request="ACK" rtd="true" crlf="true" />

  <!-- play_pcap_audio is asynchronous: it schedules the pcap's packets onto the RTP socket and
       returns at once, and a new play interrupts one still in flight. So each play is followed
       by a pause as long as the pcap itself (236 packets, ~7.05 s by its own timestamps), and
       the 5 plays make a sustained hold with continuous RTP. -->
  <nop>
    <action>
      <assign assign_to="plays" value="0"/>
    </action>
  </nop>
  <label id="play"/>
  <nop>
    <action>
      <exec play_pcap_audio="/sipp/g711a.pcap"/>
      <add assign_to="plays" value="1"/>
      <test assign_to="more" variable="plays" compare="less_than" value="5"/>
    </action>
  </nop>
  <pause milliseconds="7050"/>
  <nop next="play" test="more"/>

  <recv request="BYE" timeout="40000" />

  <send>
    <![CDATA[
      SIP/2.0 200 OK
      [last_Via:]
      [last_From:]
      [last_To:]
      [last_Call-ID:]
      [last_CSeq:]
      Content-Length: 0
    ]]>
  </send>
</scenario>
