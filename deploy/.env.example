# Zamfono stack environment (docs/spec.md §6.3 "Environment"). Copy to `.env` next to compose.yaml
# and fill in every value; Compose reads this file for interpolation only, and each service sees
# only the variables listed for it in compose.yaml. Restore this file before the database in any
# recovery: SECRETBOX_KEY is the only way to read the *_enc columns and secret settings (§5.4, §6.5).

# Public address (§6.1). FQDN is always set; exactly one of STACK_IPV4 (compose.macvlan.yaml) or
# EXTERNAL_IPV4 (compose.ports.yaml) is set, matching the mode's overlay that
# setup.sh links as compose.override.yaml.
FQDN=
STACK_IPV4=
EXTERNAL_IPV4=

# Asterisk (§9.1, §9.4). RTP_PORT_START/END default to 10000-10200 when unset.
RTP_PORT_START=
RTP_PORT_END=
ARI_PASSWORD=
AMI_PASSWORD=

# Secrets (§5.2, §5.4). SECRETBOX_KEY_PREVIOUS is set only while a key rotation is under way.
#   JWT_SECRET:    openssl rand -base64 32
#   SECRETBOX_KEY: printf '1:%s' "$(openssl rand -base64 32)"
# The leading number is the key generation; a rotation raises it and moves the old value to
# SECRETBOX_KEY_PREVIOUS until the re-encryption sweep reports nothing left to convert.
JWT_SECRET=
SECRETBOX_KEY=
SECRETBOX_KEY_PREVIOUS=

# The restic password of the local backup target api creates at first boot (§6.5 "Default
# target"), backing up nightly to the `backups` volume on this host:
#   openssl rand -hex 24
# Empty = no default target. Kept here rather than only in the database, so a restore that has
# this file can open that repository.
BACKUP_PASSWORD=

# Updates through the API (§6.3 "Updates"): set, as setup.sh sets it, `system.update` and the
# automatic update take the stack to a newer release, which the host agent setup.sh installs
# (setup/agent.sh) carries out; empty = updates only by update.sh on the host. Since 0.9.1 only
# whether it is set counts: its value is no longer a secret anything checks.
UPDATER_TOKEN=
# true lets the stack's owners switch the host's unattended upgrades and reboot the host through
# the API (§6.3 "Host control"): only where this stack has the host to itself, never where
# stacks of others share it. Empty = false: nothing of the host is shown or offered.
HOST_CONTROL=

# Mail relay, seeded once into settings.smtp_* at first boot (§10.2 "Mail"). Leave SMTP_HOST empty
# for no mail until an owner sets one; MAIL_FROM is required whenever SMTP_HOST is set.
SMTP_HOST=
SMTP_PORT=
SMTP_SECURITY=
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=

# The Ringotel Admin API key (§10.4 "Configuration and lifecycle"), seeded once, encrypted, into
# settings.ringotel_api_token_enc at first boot, unchecked; empty = no Ringotel until an owner sets
# one. Once the database holds a user it is ignored: an owner changes the key through
# settings.update. Like SMTP_PASSWORD it stays here after the seed; this file is root's alone and
# holds SECRETBOX_KEY, which reads the stored copy anyway. The key reaches every customer
# organization of the Ringotel account (§10.4 "Key scope").
RINGOTEL_API_TOKEN=

# First-boot seed (§6.3 "First boot"), read only while the database holds no user. The owner's
# BOOTSTRAP_OWNER_PASSWORD_HASH is required.
BOOTSTRAP_OWNER_EMAIL=
BOOTSTRAP_OWNER_NAME=
# Produce the Argon2id hash with the generator the api image ships:
#   read -rs PW && printf '%s' "$PW" | docker compose run --rm --no-deps -T api node hash-password.mjs
# Quote it. An Argon2id hash contains `$`, which Compose reads as a variable reference in an
# unquoted value: `$argon2id$v=19$m=65536,...` reaches the container as `=19=65536,...` and the
# owner can never log in.
BOOTSTRAP_OWNER_PASSWORD_HASH=''
COMPANY_NAME=
MAIN_DID=
COUNTRY=
EXT_LENGTH=

# Optional (§6.1, §6.4, §7, §9.1). TLS_RELOAD_HOUR: certificate swap hour when
# settings.tls_reload_hour is NULL. METRICS_TOKEN is the bearer token of GET /metrics and the full
# GET /healthz (setup.sh generates one, update.sh adds one where it is empty:
# od -An -tx1 -N32 /dev/urandom | tr -d ' \n'); empty means GET /metrics answers 404.
# HEP_ENABLED, SIP_UDP_ENABLED, SIP_TCP_ENABLED and STUN_ENABLED default to true; the last three
# false bind SIP on 5060/udp, on 5060/tcp or STUN on 3478/udp to loopback. SIP over TLS on 5061
# is always on.
TZ=
TLS_RELOAD_HOUR=
CALL_LOG_MAX_BYTES=
HEP_ENABLED=
SIP_UDP_ENABLED=
SIP_TCP_ENABLED=
STUN_ENABLED=
METRICS_TOKEN=

# The bearer token of api's and core's process-to-process /internal/* endpoints, which every
# internal caller sends, the proxy's certificate hook among them (§3.1). setup.sh generates one,
# update.sh adds one where it is empty: od -An -tx1 -N32 /dev/urandom | tr -d ' \n'. Required.
INTERNAL_TOKEN=
# Whether webhooks, voice-bot (webSocket) targets and backup targets may be on private networks
# (10/8, 172.16/12, 192.168/16, 100.64/10, fc00::/7) (§3.1 "Outbound targets"): empty or true for
# an on-premises install, false on a host shared by several customers, where those networks are
# the provider's. Loopback, link-local and the stack's own network are refused either way.
ALLOW_PRIVATE_TARGETS=

# Media storage limit (§11.6): the most the stack's recordings, voicemail and uploaded audio may
# take on the media volume, in bytes with an optional K, M, G or T (powers of 1024), e.g. 20G,
# counted as the space their files take on disk, not their lengths. At or over it, uploads answer
# 507 and no new call recording, voicemail message or greeting recorded by phone is taken.
# Empty = no limit.
MEDIA_STORAGE_MAX=

# Optional image tag for the six zamfono/ images; Compose also passes it to api and core, which
# report it as the version they're running (§7 "Version"). One of the tags the project publishes,
# each of which update.sh reads and moves along on an update by one rule (§6.3 "Updates"):
#   empty, `latest`  compose.yaml's default: in a release bundle that release itself, in the
#                    repository the newest release; update.sh leaves it as it is
#   `0.3.1`          pins that release, which update.sh sets to the release it installs; setting
#                    the previous one after restoring the upgrade's snapshot is how a rollback
#                    works (§6.3 "Migrations")
#   `0.3`, `1`       follows that line's newest release; update.sh sets the new release's line
#   `edge`           the newest build of main, for testing; update.sh pulls the newest edge
#                    images and recreates the stack, and refuses a release
#   `sha-<short commit>`
#                    one build of main, immutable; update.sh refuses to update it
# Any other value makes update.sh stop with an error. A pull request's build is never set here:
# compose.pr.yaml takes it from ZAMFONO_PR.
ZAMFONO_VERSION=
