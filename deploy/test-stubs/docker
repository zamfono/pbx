#!/usr/bin/env bash
# update-test.sh's stub runtime. Sourced, it only defines stub_digest and stub_digests. Run:
# - `docker compose version` answers; `up --help` names --wait unless STUB_PODMAN_COMPOSE, which
#   also has no `rm`, as podman-compose has neither;
# - `ps -aq`, the host agent's look for an old updater, goes unrecorded and finds one only under
#   STUB_OLD_UPDATER; under STUB_UPDATE_DURING_RM, removing it first runs ./update.sh 1.2.4 and
#   records its exit status;
# - everything else is recorded and succeeds, bar a pull under STUB_FAIL_PULL and an `up` under
#   STUB_FAIL_UP: `ps -q` names two containers, which `inspect` reports healthy and without a
#   healthcheck, and `ps -q api` api's; a pull copies the update's record, .update/state.json, to
#   $STUB_LOG.state, as it stands mid-run;
# - `compose config` names the five services' release images at ZAMFONO_VERSION, else VERSION's,
#   or under STUB_OWN_IMAGES=1 images of the operator's own in their place (=<name>: that image's
#   alone);
# - `image inspect` of ghcr.io/zamfono/<name>:<tag> reports the digest stub_digests gives <name>,
#   another for the image STUB_MOVED_IMAGE names; `volume inspect` finds no volume;
# - a call with INVOCATION_ID set records it in $STUB_LOG.env.
stub_digest() {
  echo "sha256:$(printf %s "$1" | sha256sum | cut -c1-64)"
}
# The DIGESTS of every test release: the digest the stub reports for each of the stack's images.
stub_digests() {
  local name
  for name in asterisk migrate core api proxy updater; do echo "$name $(stub_digest "$name")"; done
}
[[ ${BASH_SOURCE[0]} == "$0" ]] || return 0
if [[ $* == compose*' up --help' ]]; then
  [[ -n ${STUB_PODMAN_COMPOSE:-} ]] || echo '      --wait    Wait for services to be running|healthy.'
  exit 0
fi
# The host agent's look for an old updater container, every run: one under STUB_OLD_UPDATER.
if [[ $* == 'ps -aq '* ]]; then
  [[ -z ${STUB_OLD_UPDATER:-} ]] || echo updater-1
  exit 0
fi
echo "$*" >>"$STUB_LOG"
[[ -z ${INVOCATION_ID:-} ]] || echo "INVOCATION_ID=$INVOCATION_ID: $*" >>"$STUB_LOG.env"
if [[ -n ${STUB_UPDATE_DURING_RM:-} && $* == 'rm -f '* ]]; then
  status=0
  STUB_UPDATE_DURING_RM='' ./update.sh 1.2.4 </dev/null >"$STUB_LOG.during" 2>&1 || status=$?
  echo "update during rm: $status" >>"$STUB_LOG"
fi
case $* in
  compose*' ps -q') printf 'api-1\nmigrate-1\n' && exit 0 ;;
  compose*' ps -q api') echo a1 && exit 0 ;;
  compose*' config')
    echo services:
    for name in netns asterisk migrate core api proxy; do
      image=$name
      [[ $name != netns ]] || image=proxy
      if [[ ${STUB_OWN_IMAGES:-} == 1 || ${STUB_OWN_IMAGES:-} == "$image" ]]; then
        printf '  %s:\n    image: registry.example.com/own/%s:mine\n' "$name" "$image"
      else
        printf '  %s:\n    image: ghcr.io/zamfono/%s:%s\n' "$name" "$image" "${ZAMFONO_VERSION:-$(<VERSION)}"
      fi
    done
    exit 0
    ;;
  'image inspect --format '*' ghcr.io/zamfono/'*)
    ref=${!#}
    name=${ref##*/}
    name=${name%%:*}
    [[ $name != "${STUB_MOVED_IMAGE:-}" ]] || name=moved
    echo "${ref%:*}@$(stub_digest "$name")"
    exit 0
    ;;
  'volume inspect '*) exit 1 ;;
  inspect\ *) printf 'healthy\n\n' && exit 0 ;;
esac
[[ $* != *' pull'*|| ! -e .update/state.json ]] || cp .update/state.json "$STUB_LOG.state"
if [[ -n ${STUB_PODMAN_COMPOSE:-} && $* == *' rm '* ]]; then
  echo "podman-compose: error: argument command: invalid choice: 'rm'" >&2
  exit 2
fi
[[ -z ${STUB_FAIL_PULL:-} || $* != *' pull'* ]] && [[ -z ${STUB_FAIL_UP:-} || $* != *' up -d'* ]]
