{
  "name": "@zamfono/shared",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "db:generate": "sh scripts/db-generate.sh",
    "test": "vitest run"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "development": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./testDb.js": "./src/testDb.ts"
  },
  "types": "./src/index.ts",
  "kysely-generate": {
    "camelCase": true,
    "customImports": {
      "AudioKind": "../columnValues.js",
      "AuditChannel": "../columnValues.js",
      "BackupRunStatus": "../columnValues.js",
      "BackupTargetKind": "../columnValues.js",
      "CallDirection": "../columnValues.js",
      "CallLogLevel": "../columnValues.js",
      "CallStatus": "../columnValues.js",
      "CallerIdHeader": "../columnValues.js",
      "CountryCode": "libphonenumber-js",
      "DeviceKind": "../columnValues.js",
      "DeviceTransport": "../columnValues.js",
      "DiversionPolicy": "../columnValues.js",
      "ForwardedCallerId": "../columnValues.js",
      "HostDirection": "../columnValues.js",
      "Language": "../columnValues.js",
      "LogLevelOverride": "../columnValues.js",
      "MailKind": "../columnValues.js",
      "MaintenanceWork": "../columnValues.js",
      "NumberFormat": "../columnValues.js",
      "OAuthClientKind": "../columnValues.js",
      "PresenceStatus": "../columnValues.js",
      "QosRole": "../columnValues.js",
      "RingGroupForwardCondition": "../columnValues.js",
      "RingStrategy": "../columnValues.js",
      "SmtpSecurity": "../columnValues.js",
      "SsoProvider": "../columnValues.js",
      "TokenKind": "../columnValues.js",
      "TrunkAuthMode": "../columnValues.js",
      "TrunkTransport": "../columnValues.js",
      "UserForwardCondition": "../columnValues.js",
      "UserRole": "../columnValues.js",
      "WebhookStatus": "../columnValues.js"
    },
    "dialect": "sqlite",
    "outFile": "./src/generated/db.d.ts",
    "overrides": {
      "columns": {
        "audio_assets.kind": "AudioKind",
        "audit_log.channel": "AuditChannel",
        "backup_runs.status": "BackupRunStatus",
        "backup_targets.kind": "BackupTargetKind",
        "call_qos.role": "QosRole",
        "calls.direction": "CallDirection",
        "calls.status": "CallStatus",
        "devices.kind": "DeviceKind",
        "devices.transport": "Generated<DeviceTransport>",
        "mail_templates.kind": "MailKind",
        "mail_templates.language": "Language",
        "maintenance_gate.work": "MaintenanceWork",
        "oauth_clients.kind": "OAuthClientKind",
        "presence_log.status": "PresenceStatus",
        "ring_group_forward_rules.condition": "RingGroupForwardCondition",
        "ring_groups.log_level": "LogLevelOverride | null",
        "ring_groups.strategy": "RingStrategy",
        "settings.call_log_level": "Generated<CallLogLevel>",
        "settings.country": "CountryCode",
        "settings.language": "Generated<Language>",
        "settings.smtp_security": "Generated<SmtpSecurity>",
        "settings.sso_provider": "SsoProvider | null",
        "tokens.kind": "TokenKind",
        "trunk_hosts.direction": "Generated<HostDirection>",
        "trunks.auth_mode": "TrunkAuthMode",
        "trunks.caller_id_format": "Generated<NumberFormat>",
        "trunks.caller_id_header": "Generated<CallerIdHeader>",
        "trunks.diversion": "Generated<DiversionPolicy>",
        "trunks.forwarded_caller_id": "Generated<ForwardedCallerId>",
        "trunks.inbound_number_format": "Generated<NumberFormat>",
        "trunks.log_level": "LogLevelOverride | null",
        "trunks.transport": "Generated<TrunkTransport>",
        "user_forward_rules.condition": "UserForwardCondition",
        "users.log_level": "LogLevelOverride | null",
        "users.role": "Generated<UserRole>",
        "webhooks.last_status": "WebhookStatus | null"
      }
    },
    "url": "env(DB_FILE)"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "kysely": "^0.29.6",
    "libphonenumber-js": "^1.13.14",
    "uuid": "^14.0.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "kysely-generate": "^0.22.3"
  }
}
