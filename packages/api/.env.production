# Placeholders for the build only: `vite build` starts the server to analyse routes and to
# prerender, which validates `src/env.ts`'s required variables. Vite reads this file at build
# time; the runtime never does, and none of these variables is static, so no value reaches the
# build output.
FQDN=build.invalid
JWT_SECRET=placeholder-not-a-secret
SECRETBOX_KEY=placeholder-not-a-secret
