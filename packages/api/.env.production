# Placeholders for the build's route analysis only: `vite build` starts the server once, which
# validates `src/env.ts`'s required variables. Vite reads this file at build time; the runtime
# never does, and none of these variables is static, so no value reaches the build output.
ASTERISK_GEN_DIR=/build.invalid/asterisk-gen
CORE_URL=http://build.invalid
DB_FILE=/build.invalid/zamfono.sqlite3
FQDN=build.invalid
JWT_SECRET=placeholder-not-a-secret
MEDIA_DIR=/build.invalid/media
MIGRATIONS_DIR=/build.invalid/migrations
SECRETBOX_KEY=placeholder-not-a-secret
