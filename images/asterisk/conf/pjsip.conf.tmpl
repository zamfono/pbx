; Transports only (spec §9.1). Dynamic endpoints and trunks are rendered by `api` onto the
; `asterisk-config` volume and pulled in through the includes below.
[transport-tls]
type = transport
protocol = tls
bind = ${TLS_BIND_ADDR}:5061
cert_file = /etc/asterisk/gen/tls/cert.pem
priv_key_file = /etc/asterisk/gen/tls/privkey.pem
allow_reload = yes
; `method` unset (or `unspecified`/`default`) pins pjproject's bundled OpenSSL to TLSv1.0 only
; ("config show help res_pjsip transport method": "The default...is currently TLSv1"), which a
; TLS 1.2/1.3 client refuses to speak. The per-version choices (`tlsv1_2`, `tlsv1_3`, ...) each
; pin to exactly that one version, so they can't be combined to admit both 1.2 and 1.3. `sslv23`
; hands OpenSSL its own negotiate-highest method instead of pjproject's pinned ones; verified
; empirically against this image (openssl s_client): with `sslv23`, TLSv1.2 and TLSv1.3
; handshakes complete and TLSv1/TLSv1.1 are refused with "tlsv1 alert protocol version" (the
; OpenSSL 3 default security level excludes them from that method's range).
method = sslv23
${EXTERNAL_ADDRESS_LINES}

[transport-udp]
type = transport
protocol = udp
bind = ${UDP_BIND_ADDR}:5060
${EXTERNAL_ADDRESS_LINES}

[transport-tcp]
type = transport
protocol = tcp
bind = ${TCP_BIND_ADDR}:5060
${EXTERNAL_ADDRESS_LINES}

#include gen/pjsip_users.conf
#include gen/pjsip_trunks.conf
