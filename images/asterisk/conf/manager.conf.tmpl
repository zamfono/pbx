; AMI for outbound registration state (spec §9.4), device contacts (spec §9.3) and failed SIP
; attempts (spec §5.6): `system` read for the Registry events, `security` read for the security
; events, `system` write for the PJSIPShowRegistrationsOutbound and
; PJSIPShowEndpoint actions, since Asterisk authorises actions against the write classes. Bound to the `internal` network address alone,
; never 0.0.0.0 (spec §9.1).
[general]
enabled = yes
bindaddr = ${INTERNAL_ADDR}
port = 5038

[zamfono]
secret = ${AMI_PASSWORD}
read = system,security
write = system
