{
  "name": "zamfono-pbx",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "npm test --workspaces --if-present",
    "typecheck": "tsc -b",
    "lint": "tsc -b && eslint . --cache --cache-strategy content",
    "format": "prettier --write . && node scripts/format-md-tables.mjs",
    "format:check": "prettier --check . && node scripts/format-md-tables.mjs --check",
    "db:generate": "npm run db:generate -w packages/shared",
    "db:migrate:create": "npm run migrate:create --prefix db",
    "db:deploy": "npm run deploy --prefix db"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@types/node": "^26.6.2",
    "better-sqlite3": "^13.0.3",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-svelte": "^3.23.0",
    "globals": "^17.12.0",
    "prettier": "^3.9.9",
    "prettier-plugin-svelte": "^4.1.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.1"
  },
  "engines": {
    "node": "^26"
  },
  "overrides": {
    "kysely-generate": {
      "better-sqlite3": "$better-sqlite3"
    }
  },
  "allowScripts": {
    "argon2": true,
    "better-sqlite3": true,
    "esbuild": true
  }
}
